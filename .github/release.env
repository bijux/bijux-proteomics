# Unified release workflow configuration.

BIJUX_CRATES_RELEASE_ENABLED=false

BIJUX_GHCR_RELEASE_ENABLED=true
BIJUX_GHCR_RELEASE_PUSH_LATEST=true
BIJUX_GHCR_RELEASE_ORAS_VERSION=1.2.3
BIJUX_GHCR_RELEASE_ALLOWED_PACKAGES=agentic-proteins bijux-proteomics-foundation bijux-proteomics-core bijux-proteomics-intelligence bijux-proteomics-knowledge bijux-proteomics-lab

BIJUX_PYPI_ENABLED=true
BIJUX_PYPI_MODE=artifact
BIJUX_PYPI_ALLOWED_PACKAGES=agentic-proteins bijux-proteomics-foundation bijux-proteomics-core bijux-proteomics-intelligence bijux-proteomics-knowledge bijux-proteomics-lab
