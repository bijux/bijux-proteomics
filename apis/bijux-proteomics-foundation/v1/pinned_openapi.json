{
  "components": {
    "schemas": {
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "ReadyResponse": {
        "additionalProperties": false,
        "properties": {
          "package": {
            "const": "bijux-proteomics-foundation",
            "type": "string"
          },
          "ready": {
            "type": "boolean"
          }
        },
        "required": [
          "ready",
          "package"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "API contract for foundation-level metadata and readiness checks.\n",
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "summary": "Foundation package service contract for shared runtime metadata.",
    "title": "bijux-proteomics-foundation API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "foundationHealth",
        "responses": {
          "200": {
            "content": {
